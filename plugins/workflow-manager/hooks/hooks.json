      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$PLUGIN_ROOT\"; runner=\"$root/scripts/run_orchestrator_hook.sh\"; if [ ! -f \"$runner\" ]; then runner=\"\"; parent=\"$(dirname \"$root\")\"; for candidate in \"$parent\"/*/scripts/run_orchestrator_hook.sh; do [ -f \"$candidate\" ] || continue; if [ -z \"$runner\" ] || [ \"$candidate\" -nt \"$runner\" ]; then runner=\"$candidate\"; fi; done; fi; if [ -n \"$runner\" ]; then PLUGIN_ROOT=\"$(dirname \"$(dirname \"$runner\")\")\"; export PLUGIN_ROOT; sh \"$runner\"; fi",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$PLUGIN_ROOT\"; runner=\"$root/scripts/run_orchestrator_hook.sh\"; if [ ! -f \"$runner\" ]; then runner=\"\"; parent=\"$(dirname \"$root\")\"; for candidate in \"$parent\"/*/scripts/run_orchestrator_hook.sh; do [ -f \"$candidate\" ] || continue; if [ -z \"$runner\" ] || [ \"$candidate\" -nt \"$runner\" ]; then runner=\"$candidate\"; fi; done; fi; if [ -n \"$runner\" ]; then PLUGIN_ROOT=\"$(dirname \"$(dirname \"$runner\")\")\"; export PLUGIN_ROOT; sh \"$runner\"; fi",
