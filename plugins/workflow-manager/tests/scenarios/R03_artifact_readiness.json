{
  "schema_version": 1,
  "id": "R03",
  "title": "A dependent lane cannot spawn before its artifact is ready",
  "initial": {"agent_cap": 1, "parent_active": true},
  "events": [
    {"type": "objective", "mode": "start", "id": "obj-r03", "goal": "review a generated artifact"},
    {"type": "artifact_declare", "artifact": "patch-package", "ready": false},
    {"type": "spawn", "agent": "review-1", "scope": "artifact-review", "requires": ["patch-package"], "expect": {"allowed": false, "reason": "artifact_not_ready", "missing": ["patch-package"]}},
    {"type": "artifact_ready", "artifact": "patch-package"},
    {"type": "spawn", "agent": "review-1", "scope": "artifact-review", "requires": ["patch-package"], "expect": {"allowed": true}}
  ],
  "expect": {
    "artifacts.patch-package": true,
    "spawn_allowed": 1,
    "spawn_denied": 1,
    "denials.artifact_not_ready": 1,
    "active_agent_ids": ["review-1"]
  }
}
