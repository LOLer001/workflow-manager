{
  "schema_version": 1,
  "id": "Q01",
  "title": "Required evidence and verification continue after high context pressure and compaction",
  "coverage": {
    "trace": "quality_priority_across_pressure_and_resume",
    "production": "posttool_preservation_and_continuity_tests"
  },
  "initial": {
    "agent_cap": 0,
    "parent_active": true,
    "serial_order": [
      "evidence",
      "verify"
    ]
  },
  "events": [
    {
      "type": "objective",
      "mode": "start",
      "id": "obj-q01",
      "goal": "diagnose and verify"
    },
    {
      "type": "pressure",
      "value": 0.7,
      "expect": {
        "allowed": true,
        "checkpoint": true,
        "stop_broad": true,
        "agent_cap": 0
      }
    },
    {
      "type": "operation_start",
      "operation": "required-evidence",
      "stage": "evidence",
      "expect": {
        "allowed": true
      }
    },
    {
      "type": "operation_end",
      "operation": "required-evidence",
      "expect": {
        "allowed": true,
        "stage": "evidence"
      }
    },
    {
      "type": "compact",
      "expect": {
        "allowed": true,
        "compactions": 1
      }
    },
    {
      "type": "resume",
      "expect": {
        "allowed": true,
        "resumes": 1
      }
    },
    {
      "type": "operation_start",
      "operation": "required-acceptance",
      "stage": "verify",
      "expect": {
        "allowed": true
      }
    },
    {
      "type": "operation_end",
      "operation": "required-acceptance",
      "expect": {
        "allowed": true,
        "stage": "verify"
      }
    }
  ],
  "expect": {
    "completed_order": [
      "evidence",
      "verify"
    ],
    "operation_denied": 0,
    "max_parallel_operations": 1,
    "compactions": 1,
    "resumes": 1
  }
}
