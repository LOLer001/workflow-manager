{
  "schema_version": 1,
  "id": "F02",
  "title": "A corrected operation receives at most one retry",
  "initial": {"agent_cap": 0, "parent_active": true},
  "events": [
    {"type": "attempt", "operation": "deploy", "expect": {"allowed": true, "attempt": 1}},
    {"type": "failure", "operation": "deploy", "expect": {"allowed": true, "failures": 1}},
    {"type": "correction", "operation": "deploy", "material": true, "detail": "replace stale artifact", "expect": {"allowed": true, "material": true}},
    {"type": "retry", "operation": "deploy", "expect": {"allowed": true, "retry": 1, "attempt": 2}},
    {"type": "failure", "operation": "deploy", "expect": {"allowed": true, "failures": 2}},
    {"type": "correction", "operation": "deploy", "material": true, "detail": "repair device transport", "expect": {"allowed": true, "material": true}},
    {"type": "retry", "operation": "deploy", "expect": {"allowed": false, "reason": "retry_limit"}}
  ],
  "expect": {
    "retry.deploy.attempts": 2,
    "retry.deploy.failures": 2,
    "retry.deploy.retries": 1,
    "retry.deploy.material_corrections": 2,
    "denials.retry_limit": 1
  }
}
