{
  "schema_version": 1,
  "id": "C03",
  "title": "Only the one missing checkpoint field is queried once",
  "initial": {"agent_cap": 0, "parent_active": true},
  "events": [
    {
      "type": "checkpoint",
      "required_fields": ["objective_id", "generation", "stage", "artifact_revision", "active_agents", "recent_successes"],
      "fields": {"objective_id": "obj-c03", "generation": 1, "stage": "verify", "active_agents": [], "recent_successes": ["test-7"]},
      "expect": {"allowed": true, "missing": ["artifact_revision"]}
    },
    {"type": "checkpoint_repair", "field": "artifact_revision", "scope": "exact", "value": "rev-7", "expect": {"allowed": true, "field": "artifact_revision", "scope": "exact"}},
    {"type": "checkpoint_repair", "field": "artifact_revision", "scope": "exact", "value": "rev-7", "expect": {"allowed": false, "reason": "checkpoint_field_known"}},
    {"type": "workflow_replay", "scope": "whole-workflow", "expect": {"allowed": false, "reason": "checkpoint_repair_only"}}
  ],
  "expect": {
    "checkpoint.missing_fields": [],
    "checkpoint.repair_fields": ["artifact_revision"],
    "checkpoint.narrow_checks": 1,
    "workflow_replays": 0,
    "workflow_replay_denied": 1,
    "denials.checkpoint_field_known": 1,
    "denials.checkpoint_repair_only": 1
  }
}
